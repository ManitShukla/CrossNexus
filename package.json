{
  "name": "crossnexus-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CrossNexus - Tactical Operations Campus Platform Monorepo",
  "homepage": "https://crossnexus.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/ManitShukla/CrossNexus"
  },
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "server:dev": "npm run dev --prefix server",
    "server:start": "npm start --prefix server",
    "client:dev": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "build:mobile": "npm --prefix client run build:mobile",
    "build:apk": "npm --prefix client run build:apk"
  }
}